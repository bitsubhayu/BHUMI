# ==============================================================================
# BHUMI — Environment Variables Template
# B-H-U-M-I: Block-level Hydro-meteorological Updates for Micro-climate Intelligence
#
# NOTE: This file defines environment variable NAMES only.
# Do NOT store actual secrets, passwords, live endpoints, or tokens in this file.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (PostgreSQL with PostGIS)
# ------------------------------------------------------------------------------
# Project URL for database REST & PostGIS endpoints
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anonymous API key (safe for client-side browser usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret service-role key (server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. Regional Language & Advisory Translation (Bhashini - MeitY / Govt of India)
# ------------------------------------------------------------------------------
# Bhashini developer API key
BHASHINI_API_KEY=

# Bhashini User ID
BHASHINI_USER_ID=

# Bhashini Pipeline Inference ID
BHASHINI_PIPELINE_ID=

# ------------------------------------------------------------------------------
# 3. External Climate & Meteorological Data (Used in GitHub Actions Pipelines)
# ------------------------------------------------------------------------------
# Copernicus Climate Data Store (ERA5 / ERA5-Land Reanalysis)
CDSAPI_URL=
CDSAPI_KEY=

# NASA Earthdata Login (GPM IMERG Precipitation & SMAP Soil Moisture)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
